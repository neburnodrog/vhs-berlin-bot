# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Find yours via @userinfobot.
ALLOWED_USER_IDS=

# Daily scan time, HH:MM, local to TZ. Default 08:00.
SCAN_TIME=08:00

# Timezone for the daily schedule.
TZ=Europe/Berlin

# SQLite path inside the container (mount a volume to this dir in deploy).
DB_PATH=/data/vhsbot.db

# Where to write per-page scraped HTML snapshots for replay/debugging.
SNAPSHOT_DIR=/data/snapshots

# Logging level.
LOG_LEVEL=INFO

# Politeness sleep (seconds) between paginated POSTs to vhsit.berlin.de
SCRAPE_SLEEP_SECONDS=2
