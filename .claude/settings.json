{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run*)",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(uv lock*)",
      "Bash(uv tree*)",
      "Bash(docker build*)",
      "Bash(git *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(data/**)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*.db)",
      "Read(**/*.db-journal)",
      "Bash(rm -rf *)"
    ]
  }
}
